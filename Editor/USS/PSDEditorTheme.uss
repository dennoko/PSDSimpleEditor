/* Dark studio. DESIGN-apple.md: quiet surfaces, generous rhythm, one action blue.
   USS owns the shell; PSDEditorTheme.cs mirrors these colors for IMGUI controls. */
.root {
    --surface-0: #1d1d1f;
    --surface-1: #252527;
    --surface-2: #2e2e30;
    --outline: #3b3b3e;
    --text-primary: #f5f5f7;
    --text-secondary: #d2d2d7;
    --text-tertiary: #a1a1a6;
    --text-disabled: #737378;
    --accent: #2997ff;
    --action: #0071e3;
    --action-hover: #1482ed;
    --action-pressed: #0066cc;
    --selection: #243b52;
    --semantic-error: #ff8585;
    --surface-hover: #38383b;
    --surface-active: #424246;
    background-color: var(--surface-0);
    color: var(--text-secondary);
    font-size: 12px;
    flex-grow: 1;
    min-height: 0;
}
/* Base text first, so semantic labels retain their own hierarchy. */
.root .unity-text-element { color: var(--text-secondary); }
.grow { flex-grow: 1; min-width: 0; min-height: 0; }
.header {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-0);
    padding: 10px 16px;
    flex-shrink: 0;
}
.header-titlegroup { flex-direction: row; align-items: center; flex-shrink: 1; min-width: 0; }
.root .title { font-size: 17px; -unity-font-style: bold; color: var(--text-primary); }
.root .version-label { font-size: 10px; margin-left: 10px; color: var(--text-tertiary); }
.root .version-label--update { color: var(--accent); }
.root .version-label--error { color: var(--semantic-error); }
.root .section-header { font-size: 13px; -unity-font-style: bold; color: var(--text-primary); }
.root .caption, .root .secondary-text { font-size: 11px; color: var(--text-tertiary); }
.root .caption { overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; }
.root .control-label { font-size: 11px; color: var(--text-secondary); -unity-text-align: middle-left; }
.root .centered-caption { font-size: 12px; color: var(--text-tertiary); white-space: normal; -unity-text-align: middle-center; }
.document-bar { background-color: var(--surface-1); padding: 10px 16px 6px; flex-shrink: 0; }
.settings-row, .export-actions { flex-direction: row; align-items: center; min-height: 32px; }
.settings-label { width: 54px; flex-shrink: 0; }
.settings-input { flex-grow: 1; flex-shrink: 1; width: 0; min-width: 40px; }
.settings-object-input { flex-grow: 1; flex-shrink: 1; width: 0; min-width: 120px; }
.settings-slot-label { width: 65px; margin-left: 12px; flex-shrink: 0; }
.settings-slot-input { flex-grow: 1; flex-shrink: 1; width: 0; min-width: 80px; }
.settings-button { min-width: 60px; flex-shrink: 0; }
.settings-button-wide { min-width: 88px; flex-shrink: 0; }
.settings-toggle { margin-left: 12px; flex-shrink: 0; }
.material-settings { margin: 4px 0 0; }
.material-settings > .unity-foldout__toggle { height: 26px; margin: 0; }
.material-settings > .unity-foldout__content { margin-left: 0; padding: 4px 0 6px; }
.main-area { flex-grow: 1; min-height: 0; }
.split-view { flex-grow: 1; min-height: 0; }
.panel { padding: 0; margin: 0; min-height: 0; overflow: hidden; }
.layer-panel { background-color: var(--surface-1); min-width: 340px; }
.preview-panel { background-color: var(--surface-0); flex-grow: 1; min-width: 280px; }
.toolbar-style {
    background-color: var(--surface-1);
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 44px;
    padding: 6px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--outline);
}
.preview-panel > .toolbar-style { background-color: var(--surface-0); }
.layer-tree-scroll { flex-grow: 1; min-height: 0; }
.layer-tree-container { padding: 8px; }
.root .unity-two-pane-split-view__dragline { background-color: var(--outline); }
.root .unity-two-pane-split-view__dragline:hover { background-color: var(--accent); }
.empty-state { flex-grow: 1; min-height: 0; align-items: center; justify-content: center; padding: 16px; }
.root .empty-state .title { font-size: 24px; margin-bottom: 12px; white-space: normal; -unity-text-align: middle-center; }
.root .empty-open-button { margin-top: 20px; padding: 0 24px; height: 36px; }
.bottom-bar { background-color: var(--surface-1); padding: 8px 16px; flex-shrink: 0; border-top-width: 1px; border-top-color: var(--outline); }
.export-settings-row { margin-bottom: 4px; }
.export-actions { min-height: 36px; }
.format-label { width: 38px; margin-left: 12px; }
.format-field { width: 80px; flex-shrink: 0; }
.export-button { min-width: 120px; margin-left: 12px; }
/* Control dimensions and focus are consistent across the document and export bars. */
.root .unity-button {
    background-color: var(--surface-2);
    border-color: transparent;
    border-width: 1px;
    border-radius: 8px;
    color: var(--text-primary);
    height: 28px;
    margin: 0 0 0 6px;
    padding: 0 12px;
    font-size: 11px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.root .unity-button:hover { background-color: var(--surface-hover); }
.root .unity-button:active { background-color: var(--surface-active); }
.root .unity-button:focus { border-color: var(--accent); }
.root .button-primary { border-radius: 18px; background-color: var(--action); color: var(--text-primary); height: 32px; padding: 0 18px; }
.root .button-primary:hover { background-color: var(--action-hover); }
.root .button-primary:active { background-color: var(--action-pressed); }
.root .button-tool { color: var(--text-secondary); }
.root .unity-button.button-tool-active { background-color: var(--selection); border-color: var(--accent); color: var(--accent); }
.root .unity-button.button-tool-active:hover { background-color: var(--surface-active); }
.root .button-mini { height: 24px; padding: 0 8px; font-size: 10px; }
.root .settings-button-icon { width: 28px; padding: 0; margin-left: 4px; }
.root .version-reload-button { background-color: transparent; color: var(--text-tertiary); width: 24px; height: 24px; padding: 0; margin-left: 4px; font-size: 14px; }
.root .foldout-button { background-color: transparent; width: 22px; height: 28px; padding: 0; margin: 0; font-size: 14px; }
.foldout-spacer { width: 22px; flex-shrink: 0; }
.layer-leaf-header, .layer-group-header { flex-direction: row; align-items: center; min-height: 32px; }
.root .layer-name { font-size: 12px; color: var(--text-primary); flex-grow: 1; flex-shrink: 1; min-width: 24px; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.blend-dropdown { width: 96px; flex-shrink: 0; }
.layer-leaf-card { background-color: var(--surface-1); border-width: 1px; border-color: transparent; border-radius: 8px; padding: 4px 6px; margin: 2px 0; }
.layer-leaf-card:hover { border-color: var(--outline); }
.layer-group-outer { border-left-width: 1px; border-left-color: var(--outline); margin: 4px 0; }
.layer-group-header { background-color: var(--surface-2); padding: 4px 6px; border-radius: 8px; }
.layer-group-body { padding: 4px 0 4px 8px; }
.layer-controls { margin: 4px 0; }
.layer-leaf-card.layer-selected { background-color: var(--selection); border-color: var(--accent); }
.layer-group-outer.layer-selected { border-left-color: var(--accent); }
.layer-group-outer.layer-selected > .layer-group-header { background-color: var(--selection); }
.root .selection-count { font-size: 11px; color: var(--accent); margin-left: 6px; }
.root .selection-hint { font-size: 10px; color: var(--text-tertiary); margin-left: 6px; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.status-bar { background-color: var(--surface-0); padding: 4px 16px; min-height: 24px; font-size: 11px; white-space: normal; flex-shrink: 0; }
.root .status-info { color: var(--text-tertiary); }
.root .status-success { color: var(--accent); }
.root .status-error { color: var(--semantic-error); }
.root .unity-base-field { margin-top: 0; margin-bottom: 0; }
.root .unity-text-field__input,
.root .unity-object-field__input,
.root .unity-base-popup-field__input {
    background-color: var(--surface-0);
    border-color: var(--outline);
    border-width: 1px;
    border-radius: 8px;
    color: var(--text-primary);
    min-height: 28px;
    padding: 3px 8px;
}
.root .unity-text-field__input { --unity-selection-color: var(--selection); --unity-cursor-color: var(--text-primary); }
.root .unity-text-field__input:focus,
.root .unity-object-field__input:focus,
.root .unity-base-popup-field__input:focus { border-color: var(--accent); }
/* Style only the input surface: nested labels must not acquire another border. */
.root .unity-base-popup-field__text,
.root .unity-object-field-display__label { color: var(--text-primary); }
.root .unity-base-popup-field__arrow,
.root .unity-foldout__arrow { -unity-background-image-tint-color: var(--text-secondary); }
.root .unity-object-field__selector { background-color: var(--surface-2); border-radius: 4px; }
.root .unity-toggle__checkmark { background-color: var(--surface-0); border-width: 1px; border-color: var(--outline); border-radius: 4px; width: 16px; height: 16px; -unity-background-image-tint-color: var(--text-primary); }
.root .unity-toggle__input:checked > .unity-toggle__checkmark { background-color: var(--action); border-color: var(--action); }
.root .unity-toggle:focus > .unity-toggle__input > .unity-toggle__checkmark { border-color: var(--accent); }
.root .unity-scroller--vertical { width: 10px; }
.root .unity-scroller--vertical .unity-scroller__low-button,
.root .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.root .unity-scroller .unity-base-slider__tracker { background-color: transparent; }
.root .unity-scroller .unity-base-slider__dragger { background-color: var(--surface-active); border-width: 0; border-radius: 8px; }
.root .unity-disabled { opacity: 0.5; }
.root .unity-button:disabled { background-color: var(--surface-2); color: var(--text-disabled); border-color: transparent; }
